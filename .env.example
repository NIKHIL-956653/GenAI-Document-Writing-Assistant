# Copy to .env and fill in. Never commit .env.

# Jira (required) — https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_DOMAIN=yourname.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=

# LLM: OpenRouter (cloud) or Ollama (local; docker-compose runs it for you)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:latest

# Confluence (only for --publish confluence; uses the Jira credentials)
# CONFLUENCE_SPACE_KEY=KAN

# Google Docs (only for --publish gdocs): credentials.json / token.json paths
# GOOGLE_CREDENTIALS_FILE=credentials.json
# GOOGLE_TOKEN_FILE=token.json

# docgen
# DOCGEN_STORE=.docgen/docgen.db
# DOCGEN_OUTPUT_DIR=.

# Server (docgen serve / docker compose)
DOCGEN_API_TOKEN=change-me
# DOCGEN_LLM=openrouter
# DOCGEN_TEMPLATE=technical
# DOCGEN_CONTEXT=standard
# DOCGEN_CONCURRENCY=4
# DOCGEN_WORKERS=2

# Jira webhook → generate on transition (POST /webhooks/jira)
# DOCGEN_WEBHOOK_SECRET=
# DOCGEN_WEBHOOK_STATUSES=Done,Ready for Release
# DOCGEN_WEBHOOK_TEMPLATE=release_notes
# DOCGEN_WEBHOOK_PUBLISH=confluence
